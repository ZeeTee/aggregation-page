# 服务端环境变量(复制为 .env;.env 不入库,建议 chmod 600)

# 监听地址:只绑本机,公网由 Cloudflare 隧道转发
HOST=127.0.0.1
PORT=8080

# 日志级别:debug | info | warn | error
LOG_LEVEL=info

# 普通 /api 接口:每个 IP 每分钟请求上限
API_RATE_LIMIT=60

# 需要密钥的接口(如 /api/dsh/login-url)独立限流,应该比普通接口更严格。
# ⚠️ 不要调得太低:「重启 DSH」工具要靠轮询 login-url 等新令牌,而 dsh 启动到
#    打印 token 实测约 8.6 秒 —— 额度太小会让轮询在 token 出现前就被 429 挡住
#    (5/分钟时必然超时;30 覆盖最坏情况仍有裕量:2 + 45/2 = 25 次)。
#    真正挡住爆破的是下面的 AUTH_FAILURE_BUDGET(10 次失败即全局冷却 10 分钟),
#    这个值只限制单 IP 的请求速率。
AUTH_RATE_LIMIT=30

# 全局鉴权失败预算:窗口(10 分钟)内累计失败达到该次数 → 整个鉴权接口冷却 10 分钟
# 用于抵御换 IP 的分布式爆破;正常使用不会触发
AUTH_FAILURE_BUDGET=10

# 后端接口共享密钥。留空时所有需要密钥的接口返回 503(不接受匿名访问),而不是放行。
# 前端**每次获取都要重新输入**(不做任何保存),仅通过 X-Api-Key 头发送。
# 建议用强随机值:openssl rand -hex 32
TOOLBOX_API_KEY=

# 静态资源目录(默认 <项目根>/dist)
# DIST_DIR=/root/dshworkspace/aggregation-page/dist

# ---- DSH 登录地址接口(/api/dsh/login-url)----
# pm2 日志目录与前缀:token 只出现在 dsh web 的启动日志里
DSH_LOG_DIR=/root/.pm2/logs
DSH_LOG_PREFIX=dsh-out
# 对外 host(同时作为校验 token 时必需的 Host 头)
DSH_PUBLIC_HOST=dsh.zeetng.cloud
# 本机 dsh web 端口
DSH_PORT=3080

# ---- DSH 重启接口(POST /api/dsh/restart)----
# ⚠️ 这是唯一有副作用的接口:会重启 dsh、断开所有会话。护栏 = 密钥 + 二次确认 + 下面的冷却。
# pm2 可执行文件与数据目录(systemd 下 HOME 可能不同,显式指定更稳)
PM2_BIN=/usr/local/bin/pm2
PM2_HOME=/root/.pm2
# pm2 中的应用名
DSH_APP_NAME=dsh
# 冷却秒数:两次成功重启之间的最小间隔;设为 0 表示不限制(不建议)
DSH_RESTART_COOLDOWN=60


# ---- 手工新闻接口(GET/POST /api/news/manual)----
# 数据来自另一个项目 ai-news-daily:本服务用 execFile 调它的 CLI(newsdaily.cli.add_news),
# 读回 JSON —— 这样队列的语义(URL 规范化、条目 id、72h 去重)只有一份实现。
# ⚠️ 两个接口都需要 X-Api-Key;POST 是写操作(会进下一次日报),带冷却。
# python3 可执行文件(用绝对路径,避免 PATH 差异)
NEWS_PYTHON_BIN=/usr/bin/python3
# ai-news-daily 项目目录(作为执行时的工作目录,决定读哪个配置文件与队列)
NEWS_DAILY_DIR=/root/dshworkspace/ai-news-daily
# 抓取网页的超时秒数。必须给 server/api.ts 的 10s 单请求超时留足余量;
# 抓不到正文不算失败,条目照样入队(日报里只依据标题/导语)。
NEWS_FETCH_TIMEOUT=5
# 两次成功添加之间的最小间隔秒数(0 = 不限制);重复/非法请求不占用冷却
NEWS_ADD_COOLDOWN=3
