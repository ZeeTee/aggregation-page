# 服务端环境变量(复制为 .env;.env 不入库)

# 监听地址:只绑本机,公网由 Cloudflare 隧道转发
HOST=127.0.0.1
PORT=8080

# 日志级别:debug | info | warn | error
LOG_LEVEL=info

# 每个 IP 每分钟允许的 /api 请求数
API_RATE_LIMIT=60

# 需要凭据的后端接口(/api/dsh/* 等)使用的共享密钥。
# 留空时这些接口返回 503(不接受匿名访问),而不是放行。
# 生成方式:openssl rand -hex 32
TOOLBOX_API_KEY=

# 静态资源目录(默认 <项目根>/dist)
# DIST_DIR=/root/dshworkspace/aggregation-page/dist
